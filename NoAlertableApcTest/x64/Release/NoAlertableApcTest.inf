;
; NoAlertableApcTest.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = NoAlertableApcTest.cat
DriverVer = 10/17/2026,15.28.50.486
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
NoAlertableApcTest.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299 ; %13% support introduced in build 16299

[Standard.NTamd64.10.0...16299]
%NoAlertableApcTest.DeviceDesc% = NoAlertableApcTest_Device, Root\NoAlertableApcTest ; TODO: edit hw-id

[NoAlertableApcTest_Device.NT]
CopyFiles = File_Copy

[File_Copy]
NoAlertableApcTest.sys

;-------------- Service installation
[NoAlertableApcTest_Device.NT.Services]
AddService = NoAlertableApcTest,%SPSVCINST_ASSOCSERVICE%, NoAlertableApcTest_Service_Inst

; -------------- NoAlertableApcTest driver install sections
[NoAlertableApcTest_Service_Inst]
DisplayName    = %NoAlertableApcTest.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\NoAlertableApcTest.sys

[NoAlertableApcTest_Device.NT.Wdf]
KmdfService = NoAlertableApcTest, NoAlertableApcTest_wdfsect

[NoAlertableApcTest_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "NoAlertableApcTest Installation Disk"
NoAlertableApcTest.DeviceDesc = "NoAlertableApcTest Device"
NoAlertableApcTest.SVCDESC = "NoAlertableApcTest Service"
